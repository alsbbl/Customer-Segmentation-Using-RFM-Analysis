 fmt='.3f', cmap='RdYlGn', center=0,\n","            linewidths=1, annot_kws={'size': 13}, ax=ax,\n","            vmin=-1, vmax=1)\n","ax.set_title('Correlation Matrix RFM', fontsize=13, fontweight='bold')\n","plt.tight_layout()\n","plt.savefig('rfm_correlation.png', bbox_inches='tight')\n","plt.show()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":604},"id":"DnjkPXf7sLln","executionInfo":{"status":"ok","timestamp":1794921148911,"user_tz":-420,"elapsed":496,"user":{"displayName":"SAFIRA KHOIRULANISA SALSABILA","userId":"15573565856839724135"}},"outputId":"25ff2c47-25ab-40d1-8f4d-2e5c15adade9"},"execution_count":19,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 720x600 with 2 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"markdown","source":["data menunjukkan bahwa nilai korelasi R-F sebesar -0.261 berarti pelanggan yang sering membeli produk cenderung merupakan pelanggan baru. Sementara itu, nilai korelasi F-M sebesar 0.553 menandakan bahwa semakin sering pelanggan melakukan pembelian, maka semakin besar pula uang yang mereka belanjakan. Terakhir, nilai korelasi R-M sebesar -0.122 menunjukkan bahwa hubungan antara jangka waktu pembelian terakhir dan jumlah uang yang dibelanjakan relatif lemah."],"metadata":{"id":"m6A0moYHseH7"}},{"cell_type":"markdown","source":["# **Outlier Treatment**\n","\n","RFM data biasanya sangat skewed karena adanya customer dengan perilaku ekstrem (VIP spender, sangat jarang beli, dll)\n","\n","Kita menggunakan Log Transformation + Winsorization untuk mengurangi pengaruh outlier tanpa menghapus data."],"metadata":{"id":"nP0VuKMRsjJk"}},{"cell_type":"code","source":["# 7.1 Boxplot Before Treatment\n","fig, axes = plt.subplots(1, 3, figsize=(14, 5))\n","cols = ['Recency', 'Frequency', 'Monetary']\n","colors = ['#2196F3', '#4CAF50', '#FF9800']\n","\n","for i, (col, color) in enumerate(zip(cols, colors)):\n","    bp = axes[i].boxplot(rfm[col], patch_artist=True,\n","                         boxprops=dict(facecolor=color, alpha=0.6),\n","                         medianprops=dict(color='black', linewidth=2))\n","    axes[i].set_title(f'{col} — Before Treatment', fontsize=11, fontweight='bold')\n","    axes[i].set_ylabel(col)\n","    q1, q3 = rfm[col].quantile([0.25, 0.75])\n","    iqr = q3 - q1\n","    n_outliers = ((rfm[col] < q1 - 1.5*iqr) | (rfm[col] > q3 + 1.5*iqr)).sum()\n","    axes[i].text(1.2, rfm[col].max()*0.9, f'Outliers\\n{n_outliers:,}',\n","                 ha='center', fontsize=9, color='red')\n","\n","plt.suptitle('Boxplot RFM — Before Outlier Treatment', fontsize=13, fontweight='bold')\n","plt.tight_layout()\n","plt.show()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":556},"id":"f-cOfkWoslms","executionInfo":{"status":"ok","timestamp":1794921149135,"user_tz":-420,"elapsed":209,"user":{"displayName":"SAFIRA KHOIRULANISA SALSABILA","userId":"15573565856839724135"}},"outputId":"6eeabae9-835f-4051-8052-4d5b6afc1a68"},"execution_count":20,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1680x600 with 3 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["# 7.2 Log Transform + Winsorization\n","from scipy.stats import mstats\n","\n","rfm_treated = rfm.copy()\n","\n","for col in ['Recency', 'Frequency', 'Monetary']:\n","    # Log transform (log1p untuk handle 0)\n","    rfm_treated[col] = np.log1p(rfm_treated[col])\n","    # Winsorize pada [1%, 99%]\n","    rfm_treated[col] = mstats.winsorize(rfm_treated[col], limits=[0.01, 0.01])\n","\n","# 7.3 Boxplot After Treatment\n","fig, axes = plt.subplots(1, 3, figsize=(14, 5))\n","for i, (col, color) in enumerate(zip(cols, colors)):\n","    axes[i].boxplot(rfm_treated[col], patch_artist=True,\n","                    boxprops=dict(facecolor=color, alpha=0.6),\n","                    medianprops=dict(color='black', linewidth=2))\n","    axes[i].set_title(f'{col} — After Log+Winsorize', fontsize=11, fontweight='bold')\n","    axes[i].set_ylabel(f'log({col})')\n","\n","plt.suptitle('Boxplot RFM — After Log Transform + Winsorization', fontsize=13, fontweight='bold')\n","plt.tight_layout()\n","plt.show()\n","\n","for col in cols:\n","    sk_before = rfm[col].skew()\n","    sk_after  = rfm_treated[col].skew()\n","    print(f\"   • {col:<12}: skewness {sk_before:.2f} → {sk_after:.2f}\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":611},"id":"jYBeKcbps8YZ","executionInfo":{"status":"ok","timestamp":1794921149483,"user_tz":-420,"elapsed":345,"user":{"displayName":"SAFIRA KHOIRULANISA SALSABILA","userId":"15573565856839724135"}},"outputId":"12337933-395c-4937-afd4-a324edce655b"},"execution_count":21,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1680x600 with 3 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["   • Recency     : skewness 1.25 → -0.38\n","   • Frequency   : skewness 12.07 → 1.00\n","   • Monetary    : skewness 19.34 → 0.29\n"]}]},{"cell_type":"markdown","source":["Penerapan log transformation terbukti efektif dalam mengurangi tingkat kecondongan (skewness) sekaligus merapatkan distribusi data. Selain itu, metode winsorization pada rentang persentil 1% hingga 99% mampu membatasi nilai-nilai ekstrem (outliers) tanpa harus menghapus data berharga tersebut. Hasil perbaikan ini terlihat jelas pada grafik boxplot setelah penanganan (after treatment) yang menjadi jauh lebih simetris. Kondisi distribusi yang lebih normal dan seimbang ini membuat data menjadi jauh lebih ideal untuk algoritma pengelompokan berbasis jarak (distance-based clustering) seperti K-Means.\n","\n","Secara rincian angka, perbaikan tingkat skewness pada ketiga variabel utama adalah sebagai berikut:\n","- Nilai skewness untuk variabel Recency turun drastis dari 1.25 menjadi -0.38.\n","- Nilai skewness untuk variabel Frequency berkurang sangat signifikan dari 12.07 menjadi 1.00.\n","- Nilai skewness untuk variabel Monetary mengalami penurunan paling tajam dari 19.34 menjadi hanya 0.29."],"metadata":{"id":"2a0tp1EKtLXN"}},{"cell_type":"markdown","source":["# **Data Scaling**\n","\n","K-Mwans dan Hierarchical Clustering berbasis distance (Euclidean), sehingga sangat sensitif terhadap skala fitur. Kita menggunakan StandardScaler agar setiap fitur berkontribusi setara dalam perhitungan jarak."],"metadata":{"id":"w5BjM4P4t2-B"}},{"cell_type":"code","source":["# ── StandardScaler ────────────────────────────────────────────────────────────\n","scaler = StandardScaler()\n","rfm_scaled = scaler.fit_transform(rfm_treated[['Recency','Frequency','Monetary']])\n","rfm_scaled_df = pd.DataFrame(rfm_scaled, columns=['Recency_sc','Frequency_sc','Monetary_sc'])\n","\n","print(\" Scaling selesai dengan StandardScaler\")\n","print(f\"   Shape : {rfm_scaled_df.shape}\")\n","print(f\"\\n Statistik setelah scaling (mean≈0, std≈1):\")\n","print(rfm_scaled_df.describe().round(4))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"xLk5M0Vkt4fk","executionInfo":{"status":"ok","timestamp":1794921149519,"user_tz":-420,"elapsed":37,"user":{"displayName":"SAFIRA KHOIRULANISA SALSABILA","userId":"15573565856839724135"}},"outputId":"7f3e3c75-03e5-4947-8072-4b0df4f00c35"},"execution_count":22,"outputs":[{"output_type":"stream","name":"stdout","text":[" Scaling selesai dengan StandardScaler\n","   Shape : (4338, 3)\n","\n"," Statistik setelah scaling (mean≈0, std≈1):\n","       Recency_sc  Frequency_sc  Monetary_sc\n","count   4338.0000     4338.0000    4338.0000\n","mean      -0.0000        0.0000      -0.0000\n","std        1.0001        1.0001       1.0001\n","min       -2.3415       -0.9741      -2.1505\n","25%       -0.6614       -0.9741      -0.7055\n","50%        0.0900       -0.3643      -0.0645\n","75%        0.8450        0.6783       0.6841\n","max        1.5544        3.1483       2.7246\n"]}]},{"cell_type":"code","source":["# ── Visualisasi Perbandingan ───────────────────────────────────────────────────\n","fig, axes = plt.subplots(2, 3, figsize=(15, 8))\n","for i, col in enumerate(['Recency','Frequency','Monetary']):\n","    axes[0, i].hist(rfm_treated[col], bins=50, color='salmon', edgecolor='white', alpha=0.8)\n","    axes[0, i].set_title(f'{col} (log-transformed)', fontsize=10, fontweight='bold')\n","    axes[1, i].hist(rfm_scaled_df.iloc[:, i], bins=50, color='steelblue', edgecolor='white', alpha=0.8)\n","    axes[1, i].set_title(f'{col} (scaled)', fontsize=10, fontweight='bold')\n","\n","axes[0,0].set_ylabel('Before Scaling'); axes[1,0].set_ylabel('After Scaling')\n","plt.suptitle('Perbandingan Distribusi RFM: Before vs After Scaling', fontsize=13, fontweight='bold')\n","plt.tight_layout()\n","plt.show()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":817},"id":"ZEgwYvEFu-fY","executionInfo":{"status":"ok","timestamp":1794921150747,"user_tz":-420,"elapsed":1226,"user":{"displayName":"SAFIRA KHOIRULANISA SALSABILA","userId":"15573565856839724135"}},"outputId":"63c5619d-a820-475b-95e1-a3b94eabbef2"},"execution_count":23,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1800x960 with 6 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"markdown","source":["# **Menentukan Jumlah Cluster Optimal**\n","\n","Menemukan nilai K yang optimal menggunakan tiga metode:\n","1. Elbow Method: mencari titik \"siku\" pad aplot inertia K-Means\n","2. Silhouette Score: mengukue seberapa baik pemisahan antar cluster (semakin tinggi semakin baik, max=1)\n","3. Dendogram: visualisasi hierarki penggabungan cluster untuk Hierarchical Clustering"],"metadata":{"id":"-KIedkhwvCmN"}},{"cell_type":"code","source":["# 9.1 Elbow Method\n","k_range = range(2, 12)\n","inertias = []\n","silhouette_scores = []\n","\n","print(\" Menghitung Elbow & Silhouette untuk K=2 hingga 11...\")\n","for k in k_range:\n","    km = KMeans(n_clusters=k, random_state=42, n_init=10, max_iter=300)\n","    km.fit(rfm_scaled)\n","    inertias.append(km.inertia_)\n","    sil = silhouette_score(rfm_scaled, km.labels_)\n","    silhouette_scores.append(sil)\n","    print(f\"   K={k:2d} | Inertia={km.inertia_:,.0f} | Silhouette={sil:.4f}\")\n","\n","print(\"\\nDONE\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"iPXql-1cvAig","executionInfo":{"status":"ok","timestamp":1794921154394,"user_tz":-420,"elapsed":3641,"user":{"displayName":"SAFIRA KHOIRULANISA SALSABILA","userId":"15573565856839724135"}},"outputId":"e4a26994-e188-4be6-bd17-295ec4df767c"},"execution_count":24,"outputs":[{"output_type":"stream","name":"stdout","text":[" Menghitung Elbow & Silhouette untuk K=2 hingga 11...\n","   K= 2 | Inertia=6,322 | Silhouette=0.4361\n","   K= 3 | Inertia=4,715 | Silhouette=0.3374\n","   K= 4 | Inertia=3,773 | Silhouette=0.3394\n","   K= 5 | Inertia=3,157 | Silhouette=0.3161\n","   K= 6 | Inertia=2,707 | Silhouette=0.3148\n","   K= 7 | Inertia=2,419 | Silhouette=0.3108\n","   K= 8 | Inertia=2,209 | Silhouette=0.3060\n","   K= 9 | Inertia=2,035 | Silhouette=0.2843\n","   K=10 | Inertia=1,886 | Silhouette=0.2827\n","   K=11 | Inertia=1,761 | Silhouette=0.2771\n","\n","DONE\n"]}]},{"cell_type":"code","source":["# Plot elbow & Silhouette\n","fig, axes = plt.subplots(1, 2, figsize=(14, 5))\n","\n","# Elbow\n","axes[0].plot(list(k_range), inertias, 'bo-', markersize=8, linewidth=2)\n","axes[0].fill_between(list(k_range), inertias, alpha=0.1, color='blue')\n","axes[0].set_xlabel('Jumlah Cluster (K)', fontsize=11)\n","axes[0].set_ylabel('Inertia (Within-Cluster Sum of Squares)', fontsize=11)\n","axes[0].set_title('Elbow Method', fontsize=13, fontweight='bold')\n","axes[0].set_xticks(list(k_range))\n","best_k = list(k_range)[silhouette_scores.index(max(silhouette_scores))]\n","axes[0].axvline(best_k, color='red', linestyle='--', alpha=0.7, label=f'Optimal K={best_k}')\n","axes[0].legend()\n","\n","# Silhouette\n","axes[1].plot(list(k_range), silhouette_scores, 'rs-', markersize=8, linewidth=2)\n","axes[1].fill_between(list(k_range), silhouette_scores, alpha=0.1, color='red')\n","axes[1].set_xlabel('Jumlah Cluster (K)', fontsize=11)\n","axes[1].set_ylabel('Silhouette Score', fontsize=11)\n","axes[1].set_title('Silhouette Score per K', fontsize=13, fontweight='bold')\n","axes[1].set_xticks(list(k_range))\n","axes[1].axvline(best_k, color='blue', linestyle='--', alpha=0.7, label=f'Optimal K={best_k}')\n","axes[1].legend()\n","\n","plt.suptitle('Elbow Method & Silhouette Score untuk K-Means', fontsize=14, fontweight='bold')\n","plt.tight_layout()\n","plt.savefig('optimal_k.png', bbox_inches='tight')\n","plt.show()\n","\n","print(f\"📌 Interpretasi:\")\n","print(f\"   • Elbow Method: titik 'siku' mulai terlihat di K=3-4 → penurunan inertia mulai melambat\")\n","print(f\"   • Silhouette Score tertinggi: K={best_k} (score={max(silhouette_scores):.4f})\")\n","print(f\"   → K optimal yang dipilih: K={best_k}\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":629},"id":"iy_YNhoav8Pt","executionInfo":{"status":"ok","timestamp":1794921155491,"user_tz":-420,"elapsed":1092,"user":{"displayName":"SAFIRA KHOIRULANISA SALSABILA","userId":"15573565856839724135"}},"outputId":"edd71d09-5c7c-48fb-e1b7-57d0ea11e6c4"},"execution_count":25,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1680x600 with 2 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["📌 Interpretasi:\n","   • Elbow Method: titik 'siku' mulai terlihat di K=3-4 → penurunan inertia mulai melambat\n","   • Silhouette Score tertinggi: K=2 (score=0.4361)\n","   → K optimal yang dipilih: K=2\n"]}]},{"cell_type":"code","source":["# 9.3 Dendrogram untuk Hierarchical\n","# Sample untuk efisiensi (dendrogram full dataset terlalu besar)\n","np.random.seed(42)\n","sample_idx = np.random.choice(len(rfm_scaled), size=min(500, len(rfm_scaled)), replace=False)\n","rfm_sample = rfm_scaled[sample_idx]\n","\n","Z = linkage(rfm_sample, method='ward')\n","\n","fig, ax = plt.subplots(figsize=(16, 7))\n","dendrogram(Z, ax=ax, truncate_mode='lastp', p=30,\n","           leaf_rotation=90, leaf_font_size=9,\n","           color_threshold=0.7 * max(Z[:, 2]),\n","           show_contracted=True)\n","ax.set_title('Dendrogram — Ward Linkage (sample 500 customers)', fontsize=13, fontweight='bold')\n","ax.set_xlabel('Customer Cluster', fontsize=11)\n","ax.set_ylabel('Distance', fontsize=11)\n","\n","# Garis horizontal penanda cut\n","threshold = 0.7 * max(Z[:, 2])\n","ax.axhline(y=threshold, color='red', linestyle='--', linewidth=1.5,\n","           label=f'Cut threshold ≈ {threshold:.1f}')\n","ax.legend()\n","plt.tight_layout()\n","plt.savefig('dendrogram.png', bbox_inches='tight')\n","plt.show()\n","\n","print(\" Interpretasi:\")\n","print(\"   • Dendrogram menampilkan hierarki penggabungan cluster dari bawah ke atas\")\n","print(\"   • Garis merah (cut threshold) menunjukkan jumlah cluster optimal dari Hierarchical\")\n","print(f\"   • Ward linkage: meminimalkan variance dalam setiap cluster → menghasilkan cluster kompak\")\n","print(f\"   • Dipilih K={best_k} konsisten dengan K-Means untuk perbandingan apple-to-apple\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":764},"id":"hmUyagYgwIpR","executionInfo":{"status":"ok","timestamp":1794921157521,"user_tz":-420,"elapsed":2026,"user":{"displayName":"SAFIRA KHOIRULANISA SALSABILA","userId":"15573565856839724135"}},"outputId":"9faae952-7eec-4dec-ca5e-d617fbd142cb"},"execution_count":26,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1920x840 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":[" Interpretasi:\n","   • Dendrogram menampilkan hierarki penggabungan cluster dari bawah ke atas\n","   • Garis merah (cut threshold) menunjukkan jumlah cluster optimal dari Hierarchical\n","   • Ward linkage: meminimalkan variance dalam setiap cluster → menghasilkan cluster kompak\n","   • Dipilih K=2 konsisten dengan K-Means untuk perbandingan apple-to-apple\n"]}]},{"cell_type":"markdown","source":["Hierarchical clustering menunjukkan adanya pemisahan alami customer menjadi dua kelompok besar. Namun, pemotongan pada threshold yang lebih rendah dapat menghasilkan segmentasi yang lebih granular untuk analisis customer behavior."],"metadata":{"id":"0RtFgv8DyWLA"}},{"cell_type":"markdown","source":["# **Modeling, K-Means & Hierarchical Clustering**\n","\n","Menjalankan dua algoritma clustering pada data RFM yang sudah discaled."],"metadata":{"id":"mZB9o7YZyYUn"}},{"cell_type":"code","source":["# 10.1 K-Means Clustering\n","OPTIMAL_K = 4\n","\n","kmeans = KMeans(n_clusters=OPTIMAL_K, random_state=42, n_init=10, max_iter=500)\n","rfm['KMeans_Cluster'] = kmeans.fit_predict(rfm_scaled)\n","\n","print(f\" K-Means Clustering selesai dengan K={OPTIMAL_K}\")\n","print(f\"\\n Distribusi Cluster K-Means:\")\n","for c in sorted(rfm['KMeans_Cluster'].unique()):\n","    n = (rfm['KMeans_Cluster'] == c).sum()\n","    print(f\"   Cluster {c}: {n:>5,} customers  ({n/len(rfm)*100:.1f}%)\")\n","\n","# Centroid (dalam skala asli)\n","centroids_scaled = kmeans.cluster_centers_\n","centroids_orig = scaler.inverse_transform(centroids_scaled)\n","centroid_df = pd.DataFrame(centroids_orig, columns=['Recency_log','Frequency_log','Monetary_log'])\n","centroid_df['Cluster'] = range(OPTIMAL_K)\n","centroid_df['Recency_orig']   = np.expm1(centroid_df['Recency_log'])\n","centroid_df['Frequency_orig'] = np.expm1(centroid_df['Frequency_log'])\n","centroid_df['Monetary_orig']  = np.expm1(centroid_df['Monetary_log'])"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"ynspbU8zydiz","executionInfo":{"status":"ok","timestamp":1794921157618,"user_tz":-420,"elapsed":64,"user":{"displayName":"SAFIRA KHOIRULANISA SALSABILA","userId":"15573565856839724135"}},"outputId":"c6f40e99-39eb-4ecb-8f85-baf7e547ae1c"},"execution_count":27,"outputs":[{"output_type":"stream","name":"stdout","text":[" K-Means Clustering selesai dengan K=4\n","\n"," Distribusi Cluster K-Means:\n","   Cluster 0:   836 customers  (19.3%)\n","   Cluster 1: 1,597 customers  (36.8%)\n","   Cluster 2:   735 customers  (16.9%)\n","   Cluster 3: 1,170 customers  (27.0%)\n"]}]},{"cell_type":"code","source":["print(f\"\\n  Centroid Cluster (nilai asli approximation):\")\n","print(centroid_df[['Cluster','Recency_orig','Frequency_orig','Monetary_orig']].round(2).to_string(index=False))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"WG2updWPzI6-","executionInfo":{"status":"ok","timestamp":1794921157685,"user_tz":-420,"elapsed":38,"user":{"displayName":"SAFIRA KHOIRULANISA SALSABILA","userId":"15573565856839724135"}},"outputId":"3d9015ed-5f10-4aef-a78e-3610ebc93439"},"execution_count":28,"outputs":[{"output_type":"stream","name":"stdout","text":["\n","  Centroid Cluster (nilai asli approximation):\n"," Cluster  Recency_orig  Frequency_orig  Monetary_orig\n","       0         14.68            1.91         422.02\n","       1        153.24            1.26         271.80\n","       2          7.67           10.42        3945.54\n","       3         53.57            3.80        1397.86\n"]}]},{"cell_type":"code","source":["#  10.2 Hierarchical (Agglomerative) Clustering\n","agglo = AgglomerativeClustering(n_clusters=OPTIMAL_K, linkage='ward')\n","rfm['Hier_Cluster'] = agglo.fit_predict(rfm_scaled)\n","\n","print(f\" Hierarchical (Agglomerative) Clustering selesai dengan K={OPTIMAL_K}\")\n","print(f\"   Linkage: Ward\")\n","print(f\"\\n Distribusi Cluster Hierarchical:\")\n","for c in sorted(rfm['Hier_Cluster'].unique()):\n","    n = (rfm['Hier_Cluster'] == c).sum()\n","    print(f\"   Cluster {c}: {n:>5,} customers  ({n/len(rfm)*100:.1f}%)\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"RZiaqTzHzMHa","executionInfo":{"status":"ok","timestamp":1794921158637,"user_tz":-420,"elapsed":948,"user":{"displayName":"SAFIRA KHOIRULANISA SALSABILA","userId":"15573565856839724135"}},"outputId":"7c54cebf-d9df-4726-e552-bff3f7c896e0"},"execution_count":29,"outputs":[{"output_type":"stream","name":"stdout","text":[" Hierarchical (Agglomerative) Clustering selesai dengan K=4\n","   Linkage: Ward\n","\n"," Distribusi Cluster Hierarchical:\n","   Cluster 0: 1,540 customers  (35.5%)\n","   Cluster 1:   523 customers  (12.1%)\n","   Cluster 2: 1,012 customers  (23.3%)\n","   Cluster 3: 1,263 customers  (29.1%)\n"]}]},{"cell_type":"markdown","source":["# **Evaluasi Model**\n","\n","Membandingkan performa kedua model secara kuantitatif menggunakan tiga metrik:\n","- Silhouette score: seberapa baik cluster terpisah (range -1 to 1, semakin tinggi semakin baik)\n","- Davies-Bouldin Index: Rasio wuthin scatter vs between cluster distance (semakin rendah semakin baik)\n","- Calinski-Harabasz index: ratio of between-cluster vs within-cluster dispersion (semakin tinggi semakin baik)"],"metadata":{"id":"zuwzMVGFzOzb"}},{"cell_type":"code","source":["# Hitung Semua Metrics\n","metrics = {}\n","for model_name, labels in [('K-Means', rfm['KMeans_Cluster']), ('Hierarchical', rfm['Hier_Cluster'])]:\n","    sil = silhouette_score(rfm_scaled, labels)\n","    dbi = davies_bouldin_score(rfm_scaled, labels)\n","    chi = calinski_harabasz_score(rfm_scaled, labels)\n","    metrics[model_name] = {'Silhouette Score ↑': sil, 'Davies-Bouldin Index ↓': dbi,\n","                           'Calinski-Harabasz Index ↑': chi}\n","\n","eval_df = pd.DataFrame(metrics).T\n","print(\"=\" * 60)\n","print(\" MODEL EVALUATION COMPARISON\")\n","print(\"=\" * 60)\n","print(eval_df.round(4).to_string())\n","print(\"=\" * 60)\n","\n","# Determine winner\n","winner_sil = eval_df['Silhouette Score ↑'].idxmax()\n","winner_dbi = eval_df['Davies-Bouldin Index ↓'].idxmin()\n","winner_chi = eval_df['Calinski-Harabasz Index ↑'].idxmax()\n","print(f\"\\n Pemenang per Metrik:\")\n","print(f\"   Silhouette Score        → {winner_sil}\")\n","print(f\"   Davies-Bouldin Index    → {winner_dbi}\")\n","print(f\"   Calinski-Harabasz Index → {winner_chi}\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"-qfKVSvozWhM","executionInfo":{"status":"ok","timestamp":1794921159223,"user_tz":-420,"elapsed":583,"user":{"displayName":"SAFIRA KHOIRULANISA SALSABILA","userId":"15573565856839724135"}},"outputId":"f130f44c-b80f-43b5-ca1c-50747e33b3be"},"execution_count":30,"outputs":[{"output_type":"stream","name":"stdout","text":["============================================================\n"," MODEL EVALUATION COMPARISON\n","============================================================\n","              Silhouette Score ↑  Davies-Bouldin Index ↓  Calinski-Harabasz Index ↑\n","K-Means                   0.3394                  1.0099                  3538.4538\n","Hierarchical              0.2462                  1.2537                  2835.6516\n","============================================================\n","\n"," Pemenang per Metrik:\n","   Silhouette Score        → K-Means\n","   Davies-Bouldin Index    → K-Means\n","   Calinski-Harabasz Index → K-Means\n"]}]},{"cell_type":"code","source":["# Visualisasi Perbandingan Metrik\n","fig, axes = plt.subplots(1, 3, figsize=(14, 5))\n","metrics_list = ['Silhouette Score ↑', 'Davies-Bouldin Index ↓', 'Calinski-Harabasz Index ↑']\n","colors_models = ['#2196F3', '#FF5722']\n","\n","for i, metric in enumerate(metrics_list):\n","    vals = [metrics['K-Means'][metric], metrics['Hierarchical'][metric]]\n","    bars = axes[i].bar(['K-Means', 'Hierarchical'], vals, color=colors_models, alpha=0.85, edgecolor='white')\n","    axes[i].set_title(metric, fontsize=11, fontweight='bold')\n","    axes[i].set_ylabel('Score')\n","    for bar, v in zip(bars, vals):\n","        axes[i].text(bar.get_x() + bar.get_width()/2, bar.get_height() + max(vals)*0.01,\n","                     f'{v:.4f}', ha='center', fontsize=10, fontweight='bold')\n","\n","plt.suptitle('Perbandingan Model: K-Means vs Hierarchical Clustering', fontsize=13, fontweight='bold')\n","plt.tight_layout()\n","plt.savefig('model_evaluation.png', bbox_inches='tight')\n","plt.show()\n","\n","print(\"---Interpretasi:\")\n","print(\"   • Model dengan Silhouette Score lebih tinggi memiliki cluster yang lebih well-separated\")\n","print(\"   • Davies-Bouldin lebih rendah → cluster lebih compact & terpisah jelas\")\n","print(\"   • Calinski-Harabasz lebih tinggi → cluster lebih dense dengan pemisahan baik\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":629},"id":"GXVxxFdnz2AQ","executionInfo":{"status":"ok","timestamp":1794921160049,"user_tz":-420,"elapsed":823,"user":{"displayName":"SAFIRA KHOIRULANISA SALSABILA","userId":"15573565856839724135"}},"outputId":"765edc3c-e040-4176-d1f8-1087f87807bb"},"execution_count":31,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1680x600 with 3 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["---Interpretasi:\n","   • Model dengan Silhouette Score lebih tinggi memiliki cluster yang lebih well-separated\n","   • Davies-Bouldin lebih rendah → cluster lebih compact & terpisah jelas\n","   • Calinski-Harabasz lebih tinggi → cluster lebih dense dengan pemisahan baik\n"]}]},{"cell_type":"markdown","source":["# **Visualisasi cluster (PCA & t-SNE)**"],"metadata":{"id":"b_s-SEUxz3vA"}},{"cell_type":"code","source":["# 12.1 PCA 2D\n","pca = PCA(n_components=2, random_state=42)\n","rfm_pca = pca.fit_transform(rfm_scaled)\n","var_explained = pca.explained_variance_ratio_\n","\n","fig, axes = plt.subplots(1, 2, figsize=(16, 6))\n","palette = sns.color_palette('husl', OPTIMAL_K)\n","\n","for ax, (model_labels, model_name) in zip(axes, [\n","    (rfm['KMeans_Cluster'], 'K-Means'),\n","    (rfm['Hier_Cluster'], 'Hierarchical')\n","]):\n","    for c in sorted(model_labels.unique()):\n","        mask = model_labels == c\n","        ax.scatter(rfm_pca[mask, 0], rfm_pca[mask, 1],\n","                   c=[palette[c]], alpha=0.5, s=15, label=f'Cluster {c}')\n","    ax.set_xlabel(f'PC1 ({var_explained[0]*100:.1f}% variance)', fontsize=10)\n","    ax.set_ylabel(f'PC2 ({var_explained[1]*100:.1f}% variance)', fontsize=10)\n","    ax.set_title(f'{model_name} — PCA 2D', fontsize=12, fontweight='bold')\n","    ax.legend(markerscale=2, fontsize=9)\n","\n","plt.suptitle(f'PCA 2D Cluster Visualization (total variance explained: {sum(var_explained)*100:.1f}%)',\n","             fontsize=13, fontweight='bold')\n","plt.tight_layout()\n","plt.show()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":581},"id":"51jfLl-sz9KE","executionInfo":{"status":"ok","timestamp":1794921161150,"user_tz":-420,"elapsed":1092,"user":{"displayName":"SAFIRA KHOIRULANISA SALSABILA","userId":"15573565856839724135"}},"outputId":"b2ad7933-a1af-4d26-c633-cf4001299823"},"execution_count":32,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1920x720 with 2 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"markdown","source":["Berdasarkan hasil analisis komponen utama, metode PCA mampu menangkap keseluruhan varians data dalam dua komponen utama saja. Komponen pertama atau PC1 berhasil menjelaskan sebagian besar varians dan kemungkinan besar merepresentasikan nilai keseluruhan dari pelanggan, yang terbentuk dari kombinasi antara tingkat keseringan membeli (Frequency) dan jumlah uang yang dibelanjakan (Monetary). Sementara itu, komponen kedua atau PC2 berfokus menjelaskan varians yang kemungkinan besar merepresentasikan tingkat kebaruan transaksi pelanggan (Recency). Hasil akhir visualisasi menunjukkan bahwa kelompok data (cluster) terpisah secara jelas pada ruang PCA, yang menjadi indikasi kuat bahwa hasil segmentasi pelanggan ini berjalan dengan sangat baik."],"metadata":{"id":"GIMrTTkq06R1"}},{"cell_type":"code","source":["# 12.2 t-SNE 2D\n","print(\"🔄 Running t-SNE (ini butuh beberapa detik)...\")\n","tsne = TSNE(n_components=2, random_state=42, perplexity=40, n_iter=1000, verbose=0)\n","rfm_tsne = tsne.fit_transform(rfm_scaled)\n","\n","fig, axes = plt.subplots(1, 2, figsize=(16, 6))\n","for ax, (model_labels, model_name) in zip(axes, [\n","    (rfm['KMeans_Cluster'], 'K-Means'),\n","    (rfm['Hier_Cluster'], 'Hierarchical')\n","]):\n","    for c in sorted(model_labels.unique()):\n","        mask = model_labels == c\n","        ax.scatter(rfm_tsne[mask, 0], rfm_tsne[mask, 1],\n","                   c=[palette[c]], alpha=0.5, s=15, label=f'Cluster {c}')\n","    ax.set_xlabel('t-SNE Dim 1', fontsize=10)\n","    ax.set_ylabel('t-SNE Dim 2', fontsize=10)\n","    ax.set_title(f'{model_name} — t-SNE 2D', fontsize=12, fontweight='bold')\n","    ax.legend(markerscale=2, fontsize=9)\n","\n","plt.suptitle('t-SNE 2D Cluster Visualization', fontsize=13, fontweight='bold')\n","plt.tight_layout()\n","plt.savefig('tsne_clusters.png', bbox_inches='tight')\n","plt.show()\n","\n","print(\"\\n---Interpretasi:\")\n","print(\"   • t-SNE memperlihatkan struktur lokal cluster yang lebih detail dibanding PCA\")\n","print(\"   • Cluster yang compact dan terpisah = segmentasi berkualitas tinggi\")\n","print(\"   • Beberapa overlap antar cluster di tepi merupakan hal normal (customer borderline)\")\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":690},"id":"wBoc0jrx0BSx","executionInfo":{"status":"ok","timestamp":1794921211228,"user_tz":-420,"elapsed":50069,"user":{"displayName":"SAFIRA KHOIRULANISA SALSABILA","userId":"15573565856839724135"}},"outputId":"948be4b9-7bfd-4d3e-eef4-8c0f8e8c0bc3"},"execution_count":33,"outputs":[{"output_type":"stream","name":"stdout","text":["🔄 Running t-SNE (ini butuh beberapa detik)...\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 1920x720 with 2 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["\n","---Interpretasi:\n","   • t-SNE memperlihatkan struktur lokal cluster yang lebih detail dibanding PCA\n","   • Cluster yang compact dan terpisah = segmentasi berkualitas tinggi\n","   • Beberapa overlap antar cluster di tepi merupakan hal normal (customer borderline)\n"]}]},{"cell_type":"markdown","source":["# Cluster profiling"],"metadata":{"id":"9jlfJMSW2mED"}},{"cell_type":"code","source":["# Gunakan model terbaik untuk profiling\n","# Tentukan best model berdasarkan Silhouette Score\n","best_model = 'KMeans_Cluster' if metrics['K-Means']['Silhouette Score ↑'] >= metrics['Hierarchical']['Silhouette Score ↑'] else 'Hier_Cluster'\n","best_model_name = 'K-Means' if best_model == 'KMeans_Cluster' else 'Hierarchical'\n","print(f\"🏆 Model terbaik berdasarkan Silhouette Score: {best_model_name}\")\n","\n","# ── Profiling dengan nilai RFM ASLI\n","rfm['Best_Cluster'] = rfm[best_model]\n","profile = rfm.groupby('Best_Cluster')[['Recency','Frequency','Monetary']].agg(['mean','median','count'])\n","profile.columns = ['_'.join(c) for c in profile.columns]\n","profile = profile.rename(columns={'Recency_count': 'Cluster_Size'})\n","profile.drop(columns=[c for c in profile.columns if '_count' in c and c != 'Cluster_Size'], inplace=True, errors='ignore')\n","\n","# Gunakan nilai asli dari rfm (bukan rfm_treated)\n","profile_clean = rfm.groupby('Best_Cluster').agg(\n","    N          = ('CustomerID', 'count'),\n","    Recency_mean    = ('Recency', 'mean'),\n","    Frequency_mean  = ('Frequency', 'mean'),\n","    Monetary_mean   = ('Monetary', 'mean'),\n","    Recency_median  = ('Recency', 'median'),\n","    Frequency_median= ('Frequency', 'median'),\n","    Monetary_median = ('Monetary', 'median'),\n",").round(2)\n","profile_clean['Share_%'] = (profile_clean['N'] / profile_clean['N'].sum() * 100).round(1)\n","\n","print(\"\\n📊 CLUSTER PROFILE (Nilai RFM Asli):\")\n","print(profile_clean.to_string())"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"n0Kaywqy2ooR","executionInfo":{"status":"ok","timestamp":1794921211318,"user_tz":-420,"elapsed":76,"user":{"displayName":"SAFIRA KHOIRULANISA SALSABILA","userId":"15573565856839724135"}},"outputId":"8d9a630d-155d-42c2-b2ae-6ed318f8aed0"},"execution_count":34,"outputs":[{"output_type":"stream","name":"stdout","text":["🏆 Model terbaik berdasarkan Silhouette Score: K-Means\n","\n","📊 CLUSTER PROFILE (Nilai RFM Asli):\n","                 N  Recency_mean  Frequency_mean  Monetary_mean  Recency_median  Frequency_median  Monetary_median  Share_%\n","Best_Cluster                                                                                                               \n","0              836         19.14            2.06         523.35            18.0               2.0           454.67     19.3\n","1             1597        183.98            1.32         343.82           178.0               1.0           296.64     36.8\n","2              735         12.17           13.50        7905.99             8.0              10.0          3653.75     16.9\n","3             1170         70.65            4.08        1786.07            55.0               4.0          1338.56     27.0\n"]}]},{"cell_type":"code","source":["# Heatmap Mean RFM per Cluster\n","heatmap_data = rfm.groupby('Best_Cluster')[['Recency','Frequency','Monetary']].mean()\n","\n","# Normalize untuk heatmap\n","heatmap_norm = (heatmap_data - heatmap_data.min()) / (heatmap_data.max() - heatmap_data.min())\n","\n","fig, axes = plt.subplots(1, 2, figsize=(14, 5))\n","\n","sns.heatmap(heatmap_norm.T, annot=heatmap_data.T.round(1), fmt='g',\n","            cmap='YlOrRd', linewidths=0.5, ax=axes[0],\n","            cbar_kws={'label': 'Normalized Value'})\n","axes[0].set_title('Heatmap Mean RFM per Cluster\\n(annot = nilai asli)', fontsize=12, fontweight='bold')\n","axes[0].set_xlabel('Cluster'); axes[0].set_ylabel('RFM Feature')\n","\n","# Barplot\n","heatmap_norm.T.plot(kind='bar', ax=axes[1], color=sns.color_palette('husl', OPTIMAL_K), edgecolor='white', width=0.7)\n","axes[1].set_title('Barplot Normalized RFM per Cluster', fontsize=12, fontweight='bold')\n","axes[