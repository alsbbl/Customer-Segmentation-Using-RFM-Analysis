arang\n","    m_score = m_rank[row.name]  # 1=besar, N=kecil\n","\n","    avg_rank = (r_score + f_score + m_score) / 3\n","\n","    if r_score == 1 and f_score == 1:\n","        return \"Champions\"\n","    elif r_score <= 2 and m_score <= 2:\n","        return \"High Spenders\"\n","    elif f_score == 1:\n","        return \"Loyal Customers\"\n","    elif r_score >= cluster_profiles.shape[0] - 1:\n","        return \"Inactive / At Risk\"\n","    else:\n","        return \"Potential Loyalists\"\n","\n","cluster_profiles['Segment'] = cluster_profiles.apply(label_cluster, axis=1)\n","\n","print(\"=\" * 70)\n","print(\"----CUSTOMER SEGMENT LABELING\")\n","print(\"=\" * 70)\n","print(f\"{'Cluster':<10} {'Segment':<25} {'N':>7} {'Recency':>10} {'Freq':>8} {'Monetary':>12}\")\n","print(\"-\" * 70)\n","for idx, row in cluster_profiles.iterrows():\n","    print(f\"  {idx:<8} {row['Segment']:<25} {row['N']:>7,} {row['R_mean']:>10.1f} {row['F_mean']:>8.1f} £{row['M_mean']:>10.2f}\")\n","print(\"=\" * 70)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"L5pSiPKW2-ss","executionInfo":{"status":"ok","timestamp":1794921212430,"user_tz":-420,"elapsed":27,"user":{"displayName":"SAFIRA KHOIRULANISA SALSABILA","userId":"15573565856839724135"}},"outputId":"faf16487-8b7d-458b-d297-7a0551430b7d"},"execution_count":37,"outputs":[{"output_type":"stream","name":"stdout","text":["======================================================================\n","----CUSTOMER SEGMENT LABELING\n","======================================================================\n","Cluster    Segment                         N    Recency     Freq     Monetary\n","----------------------------------------------------------------------\n","  0        Potential Loyalists           836       19.1      2.1 £    523.35\n","  1        Inactive / At Risk          1,597      184.0      1.3 £    343.82\n","  2        Champions                     735       12.2     13.5 £   7905.99\n","  3        Inactive 